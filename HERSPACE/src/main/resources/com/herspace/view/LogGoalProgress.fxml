<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Dialog used to add progress to a goal -->
<VBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.herspace.controller.LogGoalProgressController"
      spacing="20"
      prefWidth="400"
      styleClass="card"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="25" right="25"
                bottom="25" left="25"/>
    </padding>

    <!-- Dialog title -->
    <Label text="Log Progress"
           styleClass="page-title"/>

    <!-- Goal name and current progress -->
    <VBox spacing="4">

        <Label fx:id="goalNameLabel"
               styleClass="section-title"
               wrapText="true"/>

        <Label fx:id="summaryLabel"
               styleClass="secondary-text"/>

    </VBox>

    <!-- Amount to add -->
    <VBox spacing="8">

        <Label fx:id="amountLabel"
               text="Amount to add"
               styleClass="body-text"/>

        <TextField fx:id="amountField"
                   promptText="Enter amount"/>

    </VBox>

    <!-- Validation message -->
    <Label fx:id="errorLabel"
           styleClass="error-message"
           wrapText="true"
           visible="false"
           managed="false"/>

    <!-- Dialog actions -->
    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Button fx:id="cancelButton"
                text="Cancel"
                cancelButton="true"
                styleClass="secondary-button"/>

        <Button fx:id="saveButton"
                text="Add Progress"
                defaultButton="true"
                styleClass="primary-button"/>

    </HBox>

</VBox>

