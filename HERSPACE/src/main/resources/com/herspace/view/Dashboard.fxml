<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Dashboard page layout -->
<ScrollPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.herspace.controller.DashboardController"
            fx:id="rootPane"
            fitToWidth="true"
            styleClass="main-background"
            style="-fx-background: -main-bg; -fx-background-color: transparent;">

    <VBox spacing="20">

        <!-- ===== Header: title, welcome text and date ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12">

            <VBox spacing="4">
                <Label text="Dashboard" styleClass="page-title"/>
                <Label text="Welcome back! Here is your day at a glance."
                       styleClass="page-subtitle"/>
                <Label fx:id="weeklySummaryLabel" styleClass="secondary-text"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Today's date -->
            <HBox alignment="CENTER" spacing="8" styleClass="card"
                  style="-fx-padding: 10 16 10 16;">
                <SVGPath fillRule="EVEN_ODD" style="-fx-fill: -primary-color;"
                         content="M7 2v2H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2zM5 9h14v10H5z"/>
                <Label fx:id="dateLabel" styleClass="body-text"/>
            </HBox>
        </HBox>

        <!-- Message shown after actions (success / error) -->
        <Label fx:id="statusLabel" visible="false" managed="false"
               maxWidth="Infinity" wrapText="true"/>

        <!-- ===== Statistic cards ===== -->
        <HBox spacing="16">

            <!-- Calories -->
            <VBox fx:id="caloriesCard" alignment="CENTER" spacing="6"
                  styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="150"
                  style="-fx-background-color: linear-gradient(to bottom, #FFFFFF 55%, #FBE6E3);">
                <Group>
                    <SVGPath scaleX="1.5" scaleY="1.5" style="-fx-fill: #E8857A;"
                             content="M12 2c.5 3.5 4.5 5.5 4.5 10.5a4.5 4.5 0 0 1-9 0c0-2.2 1-3.8 2.2-5 .2 1.8 1 3 2.3 3.5C11.3 8.5 11.5 5 12 2z"/>
                </Group>
                <HBox alignment="BASELINE_CENTER" spacing="4">
                    <Label fx:id="caloriesLabel" styleClass="stat-value"/>
                    <Label text="kcal" styleClass="section-title"/>
                </HBox>
                <Label text="Today's Calories" styleClass="body-text"/>
            </VBox>

            <!-- Workouts -->
            <VBox fx:id="workoutsCard" alignment="CENTER" spacing="6"
                  styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="150"
                  style="-fx-background-color: linear-gradient(to bottom, #FFFFFF 55%, #E6EDE4);">
                <Group>
                    <SVGPath scaleX="1.5" scaleY="1.5" style="-fx-fill: -primary-color;"
                             content="M2 10h2V8h2v8H4v-2H2zM22 10h-2V8h-2v8h2v-2h2zM7 6h3v12H7zM14 6h3v12h-3zM10 11h4v2h-4z"/>
                </Group>
                <Label fx:id="workoutsLabel" styleClass="stat-value"/>
                <Label text="Workouts Completed" styleClass="body-text"/>
            </VBox>

            <!-- Water (click to log water) -->
            <VBox fx:id="waterCard" alignment="CENTER" spacing="6"
                  styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="150"
                  style="-fx-background-color: linear-gradient(to bottom, #FFFFFF 55%, #E3EEF8); -fx-cursor: hand;">
                <Group>
                    <SVGPath scaleX="1.5" scaleY="1.5" style="-fx-fill: #8FBCE6;"
                             content="M12 2.5C12 2.5 5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 2.5 12 2.5z"/>
                </Group>
                <Label fx:id="waterLabel" styleClass="stat-value"/>
                <Label text="Water Intake" styleClass="body-text"/>
            </VBox>

            <!-- Goal progress -->
            <VBox fx:id="goalCard" alignment="CENTER" spacing="6"
                  styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="150"
                  style="-fx-background-color: linear-gradient(to bottom, #FFFFFF 55%, #F3E5E8);">
                <Group>
                    <SVGPath scaleX="1.5" scaleY="1.5" fillRule="EVEN_ODD" style="-fx-fill: -primary-color;"
                             content="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20zm0 3a7 7 0 1 1 0 14a7 7 0 1 1 0-14zm0 3a4 4 0 1 0 0 8a4 4 0 1 0 0-8zm0 2.5a1.5 1.5 0 1 1 0 3a1.5 1.5 0 1 1 0-3z"/>
                </Group>
                <Label fx:id="goalPercentLabel" styleClass="stat-value"/>
                <Label text="Goal Progress" styleClass="body-text"/>
            </VBox>
        </HBox>

        <!-- ===== Lower section: 2 x 2 grid ===== -->
        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="55"/>
                <ColumnConstraints percentWidth="45"/>
            </columnConstraints>

            <!-- Today's Workout -->
            <VBox spacing="12" styleClass="card"
                  GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Today's Workout" styleClass="section-title"/>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane prefWidth="56" prefHeight="56" minWidth="56"
                               style="-fx-background-color: -hover-bg; -fx-background-radius: 10;">
                        <ImageView fitWidth="28" fitHeight="28" preserveRatio="true" smooth="true">
                            <image>
                                <Image url="@../images/workouts.png"/>
                            </image>
                        </ImageView>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="workoutNameLabel" styleClass="body-text"
                               style="-fx-font-weight: bold;"/>
                        <Label fx:id="workoutDurationLabel" styleClass="secondary-text"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="startButton" styleClass="primary-button"
                            onAction="#handleStartWorkout"/>
                </HBox>
            </VBox>

            <!-- Your Goal -->
            <VBox spacing="12" styleClass="card"
                  GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Your Goal" styleClass="section-title"/>
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="goalTitleLabel" styleClass="body-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="goalCountLabel" styleClass="section-title"/>
                </HBox>
                <ProgressBar fx:id="goalProgressBar" maxWidth="Infinity"/>
            </VBox>

            <!-- Quick Actions -->
            <VBox spacing="12" styleClass="card"
                  GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Quick Actions" styleClass="section-title"/>
                <HBox fx:id="quickActionsBox" spacing="10">

                    <Button fx:id="browseWorkoutsButton" text="Browse&#10;Workouts"
                            contentDisplay="TOP" onAction="#handleBrowseWorkouts">
                        <graphic>
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true" smooth="true">
                                <image><Image url="@../images/workouts.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="mealPlanButton" text="Meal&#10;Plan"
                            contentDisplay="TOP" onAction="#handleMealPlan">
                        <graphic>
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true" smooth="true">
                                <image><Image url="@../images/nutrition.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="viewProgressButton" text="View&#10;Progress"
                            contentDisplay="TOP" onAction="#handleViewProgress">
                        <graphic>
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true" smooth="true">
                                <image><Image url="@../images/progress.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="logWaterButton" text="Log&#10;Water"
                            contentDisplay="TOP" onAction="#handleLogWater">
                        <graphic>
                            <SVGPath style="-fx-fill: -text-primary;"
                                     content="M12 2.5C12 2.5 5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 2.5 12 2.5z"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- Today's Tip (click to see another tip) -->
            <VBox fx:id="tipCard" spacing="12" styleClass="card"
                  style="-fx-cursor: hand;"
                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <SVGPath style="-fx-fill: -primary-color;"
                             content="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2zM9 19h6v1.5a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 20.5z"/>
                    <Label text="Today's Tip" styleClass="section-title"/>
                </HBox>
                <StackPane VBox.vgrow="ALWAYS" alignment="CENTER_LEFT"
                           style="-fx-background-color: -hover-bg; -fx-background-radius: 10; -fx-padding: 16;">
                    <Label fx:id="tipLabel" wrapText="true" maxWidth="Infinity"
                           styleClass="body-text"/>
                </StackPane>
                <Label text="Click the card or press Ctrl+T for another tip"
                       styleClass="secondary-text"/>
            </VBox>
        </GridPane>

        <padding>
            <Insets bottom="10"/>
        </padding>
    </VBox>
</ScrollPane>
