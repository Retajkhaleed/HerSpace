<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- Log Water window (opened from the Dashboard) -->
<VBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.herspace.controller.LogWaterController"
      stylesheets="@../css/style.css"
      styleClass="main-background"
      prefWidth="500"
      prefHeight="300"
      spacing="25">

    <!-- Dialog Header -->
    <HBox alignment="CENTER_LEFT"
          spacing="10"
          style="-fx-background-color: -hover-bg; -fx-padding: 15 20;">

        <Label text="Log Water"
               styleClass="section-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <ImageView fitWidth="45"
                   fitHeight="55"
                   preserveRatio="true">
            <image>
                <Image url="@../images/Flower.png"/>
            </image>
        </ImageView>
    </HBox>

    <!-- Input Section -->
    <HBox alignment="CENTER"
          spacing="25"
          VBox.vgrow="ALWAYS">

        <!-- Water drop icon -->
        <StackPane prefWidth="130"
                   prefHeight="130"
                   style="-fx-background-color: -hover-bg; -fx-background-radius: 12;">
            <SVGPath scaleX="3.5"
                     scaleY="3.5"
                     style="-fx-fill: #8FBCE6;"
                     content="M12 2.5C12 2.5 5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 2.5 12 2.5z"/>
        </StackPane>

        <!-- Input Field -->
        <VBox spacing="10" alignment="CENTER_LEFT">

            <Label text="Water (liters)" styleClass="body-text"/>

            <TextField fx:id="waterField"
                       promptText="e.g. 0.5"
                       prefWidth="220"
                       prefHeight="38"/>

            <Label text="Between 0.1 and 3 liters"
                   styleClass="secondary-text"/>
        </VBox>
    </HBox>

    <!-- Dialog Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="15">

        <padding>
            <Insets right="25" bottom="20"/>
        </padding>

        <Button fx:id="cancelButton"
                text="Cancel"
                cancelButton="true"
                styleClass="secondary-button"
                prefWidth="110"
                prefHeight="40"/>

        <Button fx:id="addButton"
                text="Add"
                defaultButton="true"
                styleClass="primary-button"
                prefWidth="110"
                prefHeight="40"/>
    </HBox>

</VBox>
