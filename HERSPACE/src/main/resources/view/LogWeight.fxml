<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
xmlns:fx="http://javafx.com/fxml/1"
fx:controller="com.herspace.controller.LogWeightController"
stylesheets="@../css/style.css"
prefWidth="500"
prefHeight="330"
spacing="25">

<!-- Dialog Header -->

<HBox alignment="CENTER_LEFT"
      spacing="10"
      style="-fx-background-color: #F3E5E8;
             -fx-padding: 15 20;">

    <Label text="Log Weight"
           style="-fx-font-size: 22px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #92576D;"/>

    <Region HBox.hgrow="ALWAYS"/>

    <ImageView fitWidth="45"
               fitHeight="55"
               preserveRatio="true">

        <image>
            <Image url="@../images/flower.png"/>
        </image>

    </ImageView>

</HBox>

<!-- Input Section -->

<HBox alignment="CENTER"
      spacing="25"
      VBox.vgrow="ALWAYS">

    <!-- Scale Image -->

    <StackPane prefWidth="150"
               prefHeight="150"
               style="-fx-background-color: #F3E5E8;
                      -fx-background-radius: 20;">

        <ImageView fitWidth="110"
                   fitHeight="110"
                   preserveRatio="true">

            <image>
                <Image url="@../images/scale.png"/>
            </image>

        </ImageView>

    </StackPane>

    <!-- Input Fields -->

    <VBox spacing="10" alignment="CENTER_LEFT">

        <Label text="Weight (kg)"/>

        <TextField fx:id="weightField"
                   promptText="Enter weight"
                   prefWidth="220"
                   prefHeight="38"/>

        <Label text="Date"/>

        <DatePicker fx:id="datePicker"
                    editable="false"
                    prefWidth="220"
                    prefHeight="38"/>

    </VBox>

</HBox>

<!-- Dialog Buttons -->

<HBox alignment="CENTER_RIGHT" spacing="15">

    <padding>
        <Insets right="25" bottom="20"/>
    </padding>

    <Button fx:id="cancelButton"
            text="Cancel"
            cancelButton="true"
            styleClass="secondary-button"
            prefWidth="110"
            prefHeight="40"/>

    <Button fx:id="addButton"
            text="Add"
            defaultButton="true"
            styleClass="primary-button"
            prefWidth="110"
            prefHeight="40"/>

</HBox>

</VBox>
